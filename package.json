{
  "name": "mikuro-ui",
  "private": true,
  "version": "0.1.0",
  "description": "家庭 web app 共用的 Vue 组件库:暖米 / 夜蓝配色,shadcn-vue + Reka UI + Tailwind v4,以源码形式被 app 引用",
  "type": "module",
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "bun scripts/check-palette.mjs src && bun scripts/check-raw-html.mjs src --skip src/components/ui --skip src/components/family",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "peerDependencies": {
    "vue": "^3.5.40",
    "reka-ui": "^2.10.4",
    "@vueuse/core": "^14.4.0",
    "vue-sonner": "^2.0.9"
  },
  "dependencies": {
    "@lucide/vue": "^1.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.7"
  }
}
